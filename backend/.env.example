# Uygulama
APP_ENV=development
AUTO_MIGRATE=true
APP_PORT=8080
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=5

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=your-meilisearch-key

# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_BASE_URL=https://www.paytr.com

# Trendyol
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_BASE_URL=https://api.trendyol.com/sapigw

# Hepsiburada
HB_MERCHANT_ID=
HB_USERNAME=
HB_PASSWORD=
HB_BASE_URL=https://mpop-sit.hepsiburada.com

# BizimHesap
BIZIMHESAP_API_KEY=
BIZIMHESAP_BASE_URL=https://api.bizimhesap.com

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@example.com

# Genel
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Google read-only reporting; secrets never NEXT_PUBLIC. Generate base64 32-byte key.
GOOGLE_CONFIG_KEY=
GOOGLE_CONFIG_PATH=.private/google.enc
GOOGLE_ALLOW_NETWORK=false

# Explicit local-only payment fixture; never enabled by default.
PAYMENT_MOCK_ENABLED=false

# Firebase Web Push: project will be connected later. Public web IDs are not service account secrets.
FIREBASE_ENABLED=false
FIREBASE_ALLOW_NETWORK=false
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_VAPID_KEY=
# Absolute path outside webroot, chmod 600. Never commit service-account JSON.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Durable mail/push delivery worker; enable only after SMTP/device tests
NOTIFICATION_WORKER_ENABLED=false

# Preserve existing account mail independently of new order/campaign delivery
NOTIFICATION_AUTH_EMAIL_ENABLED=false
